{
  "description": "CG Ember drafts and never sends: refuses send-shaped tools on any connection, and calendar events with guests.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__.+__(([A-Za-z0-9]+[_.-])+[sS][eE][nN][dD]([_.-][A-Za-z0-9_.-]*)?|([S][eE][nN][dD]|s[E][nN][dD]|se[N][dD]|sen[D])([_.-][A-Za-z0-9_.-]*)?|send([.-][A-Za-z0-9_.-]*|_([A-Za-eg-z0-9_.-][A-Za-z0-9_.-]*|f|f[A-Za-df-z0-9_.-][A-Za-z0-9_.-]*|fe|fe[A-Za-df-z0-9_.-][A-Za-z0-9_.-]*|fee|fee[A-Za-ce-z0-9_.-][A-Za-z0-9_.-]*|feed|feed[A-Zac-z0-9_.-][A-Za-z0-9_.-]*|feedb|feedb[A-Zb-z0-9_.-][A-Za-z0-9_.-]*|feedba|feedba[A-Zabd-z0-9_.-][A-Za-z0-9_.-]*|feedbac|feedbac[A-Za-jl-z0-9_.-][A-Za-z0-9_.-]*|feedback[A-Za-z0-9_.-]+)?)?|([A-Za-z0-9]+[_.-])*([rR][eE][pP][lL][yY]|[fF][oO][rR][wW][aA][rR][dD]|[rR][eE][sS][pP][oO][nN][dD]|[iI][nN][vV][iI][tT][eE]|[pP][oO][sS][tT]|[pP][uU][bB][lL][iI][sS][hH])([_.-][A-Za-z0-9_.-]*)?|([A-Za-z0-9]+[_.-])*share[_.-](file|folder|document|doc|item|drive[_.-]item|with)([_.-][A-Za-z0-9_.-]*)?|[A-Za-z0-9_.-]*(Send|Reply|Forward|Respond|Invite|Publish)([A-Z][A-Za-z0-9]*)?|([A-Za-z0-9]+[_.-])*(send|reply|forward|respond|invite|post|publish)[A-Z][A-Za-z0-9]*|([A-Za-z0-9]+[_.-])*([sS][eE][nN][dD]|[rR][eE][pP][lL][yY]|[fF][oO][rR][wW][aA][rR][dD]|[pP][oO][sS][tT])([eE][mM][aA][iI][lL]|[mM][aA][iI][lL]|[mM][eE][sS][sS][aA][gG][eE]|[mM][eE][sS][sS][aA][gG][eE][sS]|[aA][lL][lL]|[dD][rR][aA][fF][tT]|[nN][oO][wW])([_.-][A-Za-z0-9_.-]*)?|[A-Za-z0-9_.-]*share(File|Folder|Document|Item)[A-Za-z0-9]*|[A-Za-z0-9_.-]*Share(File|Folder|Document|Item)[A-Za-z0-9]*|(send|publish|update|schedule)[A-Za-z0-9]*Post[A-Za-z0-9]*|create([A-RT-Za-z0-9][A-Za-z0-9]*|S|S[A-Zabd-z0-9][A-Za-z0-9]*|Sc|Sc[A-Za-gi-z0-9][A-Za-z0-9]*|Sch|Sch[A-Za-df-z0-9][A-Za-z0-9]*|Sche|Sche[A-Za-ce-z0-9][A-Za-z0-9]*|Sched|Sched[A-Za-tv-z0-9][A-Za-z0-9]*|Schedu|Schedu[A-Za-km-z0-9][A-Za-z0-9]*|Schedul|Schedul[A-Za-df-z0-9][A-Za-z0-9]*|Schedule|Schedule[A-Za-ce-z0-9][A-Za-z0-9]*|Scheduled[A-Za-z0-9]+)?Post[A-Za-z0-9]*|createScheduledPost([A-EG-Za-z0-9][A-Za-z0-9]*|F|F[A-Za-np-z0-9][A-Za-z0-9]*|Fo|Fo[A-Za-qs-z0-9][A-Za-z0-9]*|For|For[A-QS-Za-z0-9][A-Za-z0-9]*|ForR|ForR[A-Za-df-z0-9][A-Za-z0-9]*|ForRe|ForRe[A-Za-uw-z0-9][A-Za-z0-9]*|ForRev|ForRev[A-Za-hj-z0-9][A-Za-z0-9]*|ForRevi|ForRevi[A-Za-df-z0-9][A-Za-z0-9]*|ForRevie|ForRevie[A-Za-vx-z0-9][A-Za-z0-9]*|ForReview[A-Za-z0-9]+)|[A-Za-z0-9_.-]*schedule[_.-]?(message|send)[A-Za-z0-9_.-]*|[A-Za-z0-9_.-]*scheduled[_.-]send[A-Za-z0-9_.-]*|([A-Za-z0-9]+[_.-])*(update|delete|patch|move|cancel)[_.-]event([_.-][A-Za-z0-9_.-]*)?|(update|delete|patch|move|cancel)[A-Za-z0-9]*Event[A-Za-z0-9]*)$",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Nothing is wrong. CG Ember never sends, replies, forwards, posts, shares, invites or changes an existing calendar event. Do not try another way. Write it as a draft where the person sends things from (an email reply is a new draft in that thread), and tell them in one sentence where the draft is.' >&2; exit 2",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__.+__(([A-Za-z0-9]+[_.-])*(create|insert|quick[_.-]add)[_.-]event([_.-][A-Za-z0-9_.-]*)?|(create|insert)[A-Za-z0-9]*Event[A-Za-z0-9]*)$",
        "hooks": [
          {
            "type": "command",
            "command": "grep -Eq '\"(attendees|attendeeEmails|addedAttendees|guests|invitees)\"[[:space:]]*:[[:space:]]*(\\[[[:space:]]*[^]\"[:space:]]|\\[[[:space:]]*\"[^\"])' && { echo 'Nothing is wrong. CG Ember never adds an event with guests, because that emails every guest. Create it with no guests, or write out the event details so the person can add it themselves.' >&2; exit 2; } || exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
